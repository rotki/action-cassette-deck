{
  "name": "action-cassette-deck",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "description": "Action to manage the synchronization between the vcr cassette repo and main rotki repo workflows",
  "type": "module",
  "keywords": [
    "actions",
    "vcr",
    "cassette"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotki/action-cassette-deck.git"
  },
  "author": "Rotki Solutions GmbH <info@rotki.com>",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "rollup -c rollup.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "all": "pnpm run build && pnpm run lint && pnpm run package && pnpm test",
    "release": "bumpp --no-push",
    "prepare": "husky"
  },
  "dependencies": {
    "@actions/core": "3.0.0",
    "@actions/github": "9.0.0",
    "@octokit/webhooks-types": "7.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@rotki/eslint-config": "5.0.1",
    "@rotki/eslint-plugin": "1.3.2",
    "@types/node": "24.12.0",
    "bumpp": "11.0.1",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "js-yaml": "4.1.1",
    "lint-staged": "16.4.0",
    "nock": "14.0.11",
    "rollup": "4.60.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "lint-staged": {
    "*.{js,ts,vue,yml,json}": "eslint"
  }
}
