{
  "name": "action-cassette-deck",
  "version": "4.0.0",
  "private": true,
  "packageManager": "pnpm@12.12.1",
  "description": "Action to manage the synchronization between the vcr cassette repo and main rotki repo workflows",
  "type": "module",
  "keywords": [
    "actions",
    "vcr",
    "cassette"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotki/action-cassette-deck.git"
  },
  "author": "Rotki Solutions GmbH <info@rotki.com>",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "rollup -c rollup.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "all": "pnpm run build && pnpm run lint && pnpm run package && pnpm test",
    "release": "bumpp --no-push",
    "prepare": "husky"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@octokit/openapi-webhooks-types": "12.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@rotki/eslint-config": "8.4.1",
    "@rotki/eslint-plugin": "1.10.0",
    "@types/node": "^24.19.2",
    "bumpp": "12.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-slop": "0.1.3",
    "eslint-plugin-tsdoc": "0.5.4",
    "husky": "9.1.7",
    "js-yaml": "5.4.3",
    "lint-staged": "17.6.0",
    "nock": "15.0.1",
    "rollup": "4.64.7",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "lint-staged": {
    "*.{js,ts,vue,yml,json}": "eslint"
  }
}
